  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:web dev:api",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "bun --watch server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "bun test",
    "capture": "bun run scripts/capture.ts"
  },

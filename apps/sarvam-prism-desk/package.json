    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },

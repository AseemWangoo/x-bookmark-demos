{
  "name": "pomerado-legacy-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "bun run --parallel dev:portal dev:api dev:web",
    "dev:portal": "bun portal/server.ts",
    "dev:api": "PORTAL_EXTERNAL=1 bun --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "portal": "bun portal/server.ts",
    "mint": "bun scripts/mint.ts",
    "record": "bun scripts/record.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "pomerado": "0.4.0-canary.390",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}

{
  "name": "async-subagent-desk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "bun --watch server/index.ts",
    "agent-server": "langgraphjs dev --config langgraph.ts.json --port 2024 --host 127.0.0.1 --no-browser --n-jobs-per-worker 10",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "bun test",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@langchain/core": "1.3.3",
    "@langchain/langgraph": "1.6.0",
    "@langchain/langgraph-checkpoint": "1.2.2",
    "@langchain/langgraph-sdk": "1.12.9",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "deepagents": "1.16.2",
    "langchain": "1.6.0",
    "langsmith": "0.11.7",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@langchain/langgraph-cli": "1.5.7",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7"
  }
}
